# ============================================================
#  SA-LIB Workshop Day 2 (AI Agents) — copy to .env and fill in ONE key
#     cp .env.example .env
# ============================================================

# ---- which LLM powers the agents? ------------------------------------
# groq | gemini | openai | deepseek | openrouter | ollama
#   groq, gemini, openrouter(:free models), ollama -> free
#   deepseek -> very cheap (small top-up)            openai -> paid
LLM_PROVIDER=groq

# optional: override the model of LLM_PROVIDER
# (defaults: groq=llama-3.3-70b-versatile, gemini=gemini-2.5-flash, openai=gpt-4o-mini,
#            deepseek=deepseek-chat, openrouter=meta-llama/llama-3.3-70b-instruct:free, ollama=qwen2.5:7b)
LLM_MODEL=

# providers tried, in order, by the *_fallback.py and agent.py examples (after LLM_PROVIDER)
LLM_FALLBACKS=groq,gemini

# ---- API keys (only the ones you use) --------------------------------
GROQ_API_KEY=              # https://console.groq.com    (free, no card)
GOOGLE_API_KEY=            # https://aistudio.google.com (free, no card) — also used by Google ADK
OPENAI_API_KEY=            # https://platform.openai.com/api-keys
DEEPSEEK_API_KEY=          # https://platform.deepseek.com
OPENROUTER_API_KEY=        # https://openrouter.ai/keys
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- framework switches (leave as they are) --------------------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE   # Google ADK: use the AI Studio key, not Google Cloud
CREWAI_TRACING_ENABLED=false      # CrewAI: don't ask about cloud tracing

# ---- monitoring (optional, only for 08_monitoring) ---------------------
# LangSmith — https://smith.langchain.com (free Developer plan). when true, EVERY LangChain/LangGraph
# script in this repo is traced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sa-lib-day2

# Langfuse
LANGFUSE_PUBLIC_KEY=       # https://cloud.langfuse.com (free) or self-hosted
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
