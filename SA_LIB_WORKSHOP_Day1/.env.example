# ============================================================
#  SA-LIB Workshop Day 1 (RAG) — copy to .env and fill in ONE key
#     cp .env.example .env
# ============================================================

# ---- which LLM answers the questions? --------------------------------
# openai | deepseek | groq | gemini | openrouter | ollama
#   groq, gemini, openrouter(:free models), ollama  -> free
#   deepseek -> very cheap (needs a small top-up)     openai -> paid
LLM_PROVIDER=groq

# optional: override the default model of the provider
# (defaults: openai=gpt-4o-mini, deepseek=deepseek-chat, groq=llama-3.3-70b-versatile,
#            gemini=gemini-2.5-flash, openrouter=meta-llama/llama-3.3-70b-instruct:free, ollama=qwen2.5:7b)
LLM_MODEL=

# ---- API keys (you only need the one for your LLM_PROVIDER) -----------
OPENAI_API_KEY=            # https://platform.openai.com/api-keys
DEEPSEEK_API_KEY=          # https://platform.deepseek.com
GROQ_API_KEY=              # https://console.groq.com   (free, no card)
GOOGLE_API_KEY=            # https://aistudio.google.com (free, no card)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys (free models end in :free)
# local server, no key. Also works for SGLang (http://localhost:30000/v1) or vLLM (http://localhost:8000/v1):
# keep LLM_PROVIDER=ollama and set LLM_MODEL to the model your server runs.
OLLAMA_BASE_URL=http://localhost:11434/v1   # local models, no key: https://ollama.com

# ---- embeddings (turning text into vectors) --------------------------
# local  = free, runs on your CPU (fastembed, BAAI/bge-small-en-v1.5)   <- recommended
# openai = text-embedding-3-small (needs OPENAI_API_KEY)
# gemini = gemini-embedding-001  (needs GOOGLE_API_KEY)
# ollama = nomic-embed-text      (run: ollama pull nomic-embed-text)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
